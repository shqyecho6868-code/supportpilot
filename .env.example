# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Main model. The code default is Sonnet (production); local dev uses Haiku to save cost.
ANTHROPIC_MODEL=claude-haiku-5-5

# "anthropic" calls Claude. "rule_based" is a deterministic offline stand-in
# used by the test suite; it is not a real model.
LLM_PROVIDER=anthropic

DATABASE_URL=postgresql://supportpilot:supportpilot@localhost:5432/supportpilot
REDIS_URL=redis://localhost:6379/0

# Short-term memory: how many messages to keep per session, and for how long.
MEMORY_MAX_MESSAGES=20
MEMORY_TTL_SECONDS=86400

# --- Reliability -------------------------------------------------------------------------------
# Transient errors (429, 5xx, timeouts) are retried with exponential backoff; if the main model
# still fails, or does not exist, the call is repeated on FALLBACK_MODEL.
FALLBACK_MODEL=claude-haiku-5-5
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
# Tokens per conversation (input + output, including cached input). Past it the assistant hands
# the conversation to a human. 0 disables the limit.
CONVERSATION_TOKEN_LIMIT=200000
# Seconds before a pending confirmation (address change) expires.
CONFIRMATION_TTL_SECONDS=900

# --- Knowledge agent ---------------------------------------------------------------------------
# Agentic RAG (decide / grade / rewrite, at most 2 extra searches). Off by default: see
# docs/eval-report.md for the comparison.
AGENTIC_RAG=false
RETRIEVAL_RERANK=true

# --- Memory and guard --------------------------------------------------------------------------
# Long-term memory across sessions (mem0 in pgvector; Haiku extracts memories after each turn).
LONG_TERM_MEMORY=true
MEM0_TELEMETRY=False
INJECTION_GUARD=true

# --- Langfuse (cloud) ----------------------------------------------------------------------------
# Tracing is on when both keys are set. EU region: https://cloud.langfuse.com,
# US region: https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
APP_ENVIRONMENT=development
